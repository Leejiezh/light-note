{
  "name": "light-note",
  "version": "1.0.0",
  "description": "轻记 · 记录笔记的小程序（uni-app + Vue 3 + Vite）",
  "private": true,
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build",
    "test": "vitest run",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4030620241128001",
    "@dcloudio/uni-components": "3.0.0-4030620241128001",
    "@dcloudio/uni-h5": "3.0.0-4030620241128001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4030620241128001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-4030620241128001",
    "@dcloudio/uni-cli-shared": "3.0.0-4030620241128001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4030620241128001",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "sass": "^1.77.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.2.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "vue-router": "4.5.1",
    "vue": "3.4.21"
  }
